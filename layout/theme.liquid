    <script>
  document.addEventListener("junip:product:summary:loaded", function (event) {
    // Confirm it loaded for the correct product
    if (event.detail.productSummary.productId === "7947823382562") {
      const avgRating = event.detail.productSummary.averageRating?.toFixed(1);
      const reviewCount = event.detail.productSummary.reviewCount;

      const text = `${avgRating} ★ average from ${reviewCount} verified buyer${reviewCount > 1 ? 's' : ''}`;
      document.getElementById("attaboy-rating-text").innerText = text;
    }
  });
</script>
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.querySelector('.scroll-to-top-btn');

    const waitForTarget = setInterval(() => {
      const targetBlock = document.querySelector('.product__block.product__badges.block-padding');

      if (btn && targetBlock) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();

          const elementPosition = targetBlock.getBoundingClientRect().top + window.pageYOffset;
          const offset = window.innerHeight * 0.25; // 25% of screen height

          window.scrollTo({
            top: elementPosition - offset,
            behavior: 'smooth'
          });
        });

        clearInterval(waitForTarget);
      }
    }, 200);
  });
</script>
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyATC = document.querySelector('.stick-atc');

    function handleScroll() {
      const scrollY = window.scrollY || window.pageYOffset;
      const triggerPoint = window.innerHeight * 1.1; // 110vh

      if (stickyATC) {
        if (scrollY > triggerPoint) {
          stickyATC.classList.add('show');
        } else {
          stickyATC.classList.remove('show');
        }
      }
    }

    // Run on load and scroll
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  });
</script>
  {{'tiny-img-link-preloader.js' | asset_url | script_tag }}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.location.pathname !== "/") return;

    const atc = document.querySelector(".sticky-atc");
    const hero = document.querySelector(".vid-pack-hero");
    if (!atc || !hero) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          // Add when hero is less than 50% visible
          if (entry.intersectionRatio < 0.5) {
            atc.classList.add("visible");
          } else {
            atc.classList.remove("visible");
          }
        });
      },
      {
        threshold: 0.5
      }
    );

    observer.observe(hero);
  });
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyEl = document.querySelector('.iLzDjl6AmoAkmMeEE');
    const endTrigger = document.querySelector('.iVigNESzRaSV8i0ch');

    if (!stickyEl || !endTrigger) return;

    function checkPosition() {
      const triggerRect = endTrigger.getBoundingClientRect();
      const stickyRect = stickyEl.getBoundingClientRect();

      if (triggerRect.bottom <= stickyRect.bottom) {
        stickyEl.style.visibility = 'hidden';
        stickyEl.style.pointerEvents = 'none';
      } else {
        stickyEl.style.visibility = 'visible';
        stickyEl.style.pointerEvents = 'auto';
      }
    }

    window.addEventListener('scroll', checkPosition);
    window.addEventListener('resize', checkPosition);
    checkPosition(); // Initial run
  });
</script>
