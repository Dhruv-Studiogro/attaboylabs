        "text_9Gbo7ncNpOfRjDME": "<p>Acetyl-L-carnitine</p>",
        "text_qPgs9pzu4SoGL0tK": "<p>1.5 grams</p>",
        "text_9LYaCPWRzoY7tBwC": "<p>Metabolism</p>",
        "text_SKVxufUZidHFUmvU": "<p>Mitochondria</p>",
        "text_A8zlIOGMpADr59DG": "<p>Energy</p>",
        "text_dKwL2kvzh3DJrlan": "<p>magnesium glycinate</p>",
        "text_XNLe1nybop8Eqmd8": "<p>1 gram</p>",
        "text_YmnvrNUhUXxEPBmq": "<p>Muscle</p>",
