024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/22f6aa3e-70e1-410a-bb37-2bd2187af329?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/22f6aa3e-70e1-410a-bb37-2bd2187af329" class="r-k33eex" loading="eager"/></picture><div data-rid="baae8d7e-5df7-470e-a823-7c5bfa18ccef" class="r-1mfonha"><div data-rid="2444515f-c98a-475c-b4a6-e53dcb335254" class="r-18j0x1r alchemy-rte" style="--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-606c16be-6e1b-4d50-b471-2c69cced36f7-attributes-color:#000000;--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-78e9dc7f-e350-4fa5-ac3d-5f0f41857a0d-attributes-color:#f26729"><span style="width:100%"><p>L-THEANINE (300mg)</p></span></div><div data-rid="acd49150-332c-4f05-abe7-17ea59c77b6d" class="r-12ask0b alchemy-rte" style="--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-606c16be-6e1b-4d50-b471-2c69cced36f7-attributes-color:#000000"><span style="width:100%"><p>Keeps you calm when the world’s loud. L-Theanine supports alpha brain waves—the ones linked to focus and flow—helping you stay sharp under pressure without feeling wired or worn out.</p></span></div></div></div><div data-rid="a0ec2a33-8df9-4d50-bba4-64fddcdc4091" class="r-1gcd99g"><picture data-rid="698cc8ef-ecc5-4c58-91cb-bbd25d3a4aab" class="r-3zjgzk"><source srcSet="https://cdn.shopify.com/s/files/1/0795/9012/9698/files/rock-running.jpg?v=1750521137&amp;width=820" media="(max-width: 640px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0795/9012/9698/files/rock-running.jpg?v=1750521137&amp;width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0795/9012/9698/files/rock-running.jpg?v=1750521137&amp;width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://cdn.shopify.com/s/files/1/0795/9012/9698/files/rock-running.jpg?v=1750521137" class="r-19l2drv" loading="eager"/></picture><div data-rid="3c78dcc0-c861-4d1a-9811-68da813eef0d" class="r-13g1c72"><div data-rid="a4e54edf-6095-4f51-a957-34112adb7fb9" class="r-ck4esr alchemy-rte" style="--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-606c16be-6e1b-4d50-b471-2c69cced36f7-attributes-color:#000000;--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-78e9dc7f-e350-4fa5-ac3d-5f0f41857a0d-attributes-color:#f26729"><span style="width:100%"><p>ACETYL-L-CARNITINE (1.5g)</p></span></div><div data-rid="faeba5be-9fb7-4724-9e56-1c63deac1f8a" class="r-n3grh alchemy-rte" style="--replo-library-c1a8c56f-d134-48db-bdea-c4ba0a1e6710-styles-606c16be-6e1b-4d50-b471-2c69cced36f7-attributes-color:#000000"><span style="width:100%"><p>Turns fat into fuel and fog into focus. Acetyl-L-Carnitine helps your body convert stored fat into energy while boosting brain performance for sharper thinking and longer-lasting drive.</p></span></div></div></div><div data-rid="77ef585b-9496-4e01-a900-4034646e5bdf" class="r-1cmq1xd"><picture data-rid="00a88ff3-8007-4d1a-acaa-aa47932abd71" class="r-1337flh"><source srcSet="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/c18cfaed-06ba-44aa-ab6e-6053fbe8b744?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/c18cfaed-06ba-44aa-ab6e-6053fbe8b744?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/c18cfaed-06ba-44aa-ab6e-6053fbe8b744?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/8a734d7d-8e00-4610-914e-30c6f6c7f5fc/c18cfaed-06ba-44aa-ab6e-6053fbe8b744" alt="Sunlight shining through tall trees in a lush forest." class="r-1vrw97f" loading="eager"/></picture><div data-rid="d057967d-993b-481f-acea-784ee5