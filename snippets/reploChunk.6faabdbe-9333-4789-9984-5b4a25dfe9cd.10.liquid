-rte"><span style="width:100%"><p>serving: 180 milligrams</p></span></div></div><div data-rid="0fc9d9ae-b8cc-4139-89fc-062233f4c4c7" class="r-pzul28"><div data-rid="29fa82c0-abcc-48f0-9ebb-f1b9b9bb21ed" class="r-1obstu2 alchemy-rte"><span style="width:100%"><p>MUSCLE CONTRACTION</p></span></div><div data-rid="42afa8e8-f0ff-458d-a80c-5f41e3157d6a" class="r-1cv3wz6 alchemy-rte"><span style="width:100%"><p>NERVE SIGNALING</p></span></div><div data-rid="2b57a7b0-3240-451e-be54-cb7a50ed5994" class="r-59g7fc alchemy-rte"><span style="width:100%"><p>ELECTROLYTE SUPPORT</p></span></div></div></div></div></div></div><div data-rid="4831c224-a81b-4ae7-a5a2-158108646139" class="r-1fwaqod alchemy-rte"><span style="width:100%"><p>SLIDE 9 OF 10</p></span></div></div></div></div></div><div data-replo-component-root="carousel" data-replo-part="slide" data-replo-root-id="replo-carousel:Rbpb2:" data-slide-index="9" data-slide-source-index="9" data-is-cloned="true" data-slide-id="replo-carousel:Rbpb2::slide:9:9" id="replo-carousel:Rbpb2::slide:9:9:Rarpb2::clone:9" aria-hidden="true" tabindex="-1" role="group" aria-label="Slide 10" style="display:flex;height:100%;padding:0;margin:0;backface-visibility:hidden;flex-shrink:0;position:relative" data-component-id="f6660c21-f321-4478-b942-3a67ffddc285" class="r-r0btbq"><div data-rid="f6660c21-f321-4478-b942-3a67ffddc285" class="r-pfhb6t"><div data-rid="26bb3683-d0bb-47cc-b135-89b23bf2e10c" class="r-1hcqlof"></div><div data-rid="0559007f-55be-486a-b0d8-5eb70126ffac" class="r-18dfsbc"><div data-rid="cd2f260a-4a45-4ece-a020-d1f515d245fe" class="r-1mwts2v"><div data-rid="36df0851-5e55-48b6-95f5-14190a7b1b06" class="r-1o4ohzg alchemy-rte"><span style="width:100%"><p>SODIUM CITRATE</p></span></div><div data-rid="35294db0-50de-4d11-ac6a-e1ca6a6cb309" class="r-il6f2g alchemy-rte"><span style="width:100%"><p>+2.9%</p></span></div><div data-rid="f11fb434-10ca-40e2-871c-abf38bae5dd5" class="r-cx0e06 alchemy-rte" style="--replo-library-c1a8c56f-d134-48db